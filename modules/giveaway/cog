def build_giveaway_embed(
    guild_name: str,
    prize: str,
    winners: int,
    host_mention: str,
    end_timestamp: int,
    image_url: Optional[str] = None,
) -> discord.Embed:
    winner_str = f"**{winners}**" if winners > 1 else "**1**"
    upper_name = guild_name.upper()
    desc = (
        f"{EMOJI_PARTY_CAT} **{upper_name} PRESENT GIVEAWAY** {EMOJI_PARTY_CAT}\n\n"
        f"{EMOJI_ARROW} **prize -** **{prize}**\n\n"
        f"{EMOJI_BUTTERFLY} **winner -** {winner_str}\n"
        f"{EMOJI_BUTTERFLY} **hosted by -** {host_mention}\n"
        f"{EMOJI_BUTTERFLY} **ends -** <t:{end_timestamp}:R> (<t:{end_timestamp}:f>)\n\n"
        f"{EMOJI_ARROW} **react on the YOGI JI** {EMOJI_CHADYOGI} **to enter the giveaway**\n\n"
        f"good luck to everyone entering {EMOJI_FEATHER}"
    )
    embed = discord.Embed(
        description=desc,
        colour=discord.Colour.from_rgb(47, 49, 54),
    )
    if image_url:
        embed.set_image(url=image_url)
    return embed


