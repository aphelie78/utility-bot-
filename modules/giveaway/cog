class GiveawayCog(commands.Cog, name="Giveaway"):
    """Giveaway system with custom styled templates, image/GIF banners, and automated timer ending."""

    giveaway_slash = app_commands.Group(
        name="giveaway",
        description="Host and manage server giveaways",
        guild_only=True,
        default_permissions=discord.Permissions(manage_guild=True),
    )

    def __init__(self, bot: commands.Bot) -> None:
        self.bot = bot
        self.service = GiveawayService(bot)
        # Track recent announcement template indices per guild to prevent repetition within 4 draws
        self._recent_templates: dict[int, list[int]] = {}

    def get_winner_announcement(self, guild_id: int, users: str, prize: str, host: str) -> str:
        recent = self._recent_templates.setdefault(guild_id, [])
        all_indices = list(range(len(WINNER_ANNOUNCEMENT_TEMPLATES)))
        # Filter out templates used in the last 4 announcements
        allowed = [i for i in all_indices if i not in recent[-4:]]
        if not allowed:
            allowed = all_indices

        chosen_idx = random.choice(allowed)
        recent.append(chosen_idx)
        # Keep list memory manageable
        if len(recent) > 20:
            self._recent_templates[guild_id] = recent[-10:]

        template = WINNER_ANNOUNCEMENT_TEMPLATES[chosen_idx]
        return template.format(users=users, prize=prize, host=host)

    async def cog_load(self) -> None:
        await self.service.init_db()
        self.giveaway_check_loop.start()

    async def cog_unload(self) -> None:
        self.giveaway_check_loop.cancel()

    @tasks.loop(seconds=10)
    async def giveaway_check_loop(self) -> None:
        """Periodic loop to end giveaways whose time has elapsed."""
        due = await self.service.get_due_giveaways()
        for gw in due:
            await self._finalize_giveaway(gw["message_id"])

    async def _finalize_giveaway(self, message_id: int) -> None:
        channel_row = await self.service.get_giveaway(message_id)
        if not channel_row:
            return

        channel = self.bot.get_channel(channel_row["channel_id"])
        if channel:
            try:
                msg = await channel.fetch_message(message_id)
                # Sync reactors as fallback to ensure 100% of participants are entered
                for reaction in msg.reactions:
                    if (isinstance(reaction.emoji, discord.Emoji) and reaction.emoji.id == 1569432959512223815) or str(reaction.emoji) in ("🎉", "🎁"):
                        async for u in reaction.users():
                            if not u.bot:
                                await self.service.add_entry(message_id, u.id)
            except discord.HTTPException:
                msg = None
        else:
            msg = None

        res = await self.service.end_giveaway(message_id)
        if not res:
            return
        gw, winners = res

        if not channel:
            return

        guild_name = channel.guild.name if channel.guild else "SERVER"
        img_url = gw.get("image_url")

        if winners:
            winners_mentions = ", ".join(f"<@{uid}>" for uid in winners)
            embed = build_giveaway_ended_embed(guild_name, gw["prize"], winners_mentions, f"<@{gw['host_id']}>", image_url=img_url)
            announcement_text = self.get_winner_announcement(
                channel.guild.id,
                users=winners_mentions,
                prize=gw["prize"],
                host=f"<@{gw['host_id']}>",
            )
            announcement_embed = discord.Embed(
                description=announcement_text,
                colour=discord.Colour.from_rgb(255, 182, 193),
            )
        else:
            embed = build_giveaway_ended_embed(guild_name, gw["prize"], "No valid entries", f"<@{gw['host_id']}>", image_url=img_url)
            announcement_embed = discord.Embed(
                description=f"{EMOJI_CONFUSE} Nobody entered the giveaway for **{gw['prize']}** {EMOJI_MUTHAL}.",
                colour=discord.Colour.dark_grey(),
            )
            winners_mentions = None

        if msg:
            try:
                await msg.edit(embed=embed)
            except discord.HTTPException:
                pass

        if winners_mentions:
            content_text = f"{EMOJI_PARTY_CAT} CONGRATS {winners_mentions} YOU WON GIVEAWAY BY <@{gw['host_id']}> {EMOJI_FEATHER}"
            await channel.send(content=content_text, embed=announcement_embed)
        else:
            await channel.send(embed=announcement_embed)

    # ─────────────────────────────────────────── Reaction Listeners (React on YOGI JI to Enter)

    @commands.Cog.listener()
    async def on_raw_reaction_add(self, payload: discord.RawReactionActionEvent) -> None:
        if payload.user_id == self.bot.user.id or payload.guild_id is None:
            return
        gw = await self.service.get_giveaway(payload.message_id)
        if not gw or gw.get("ended"):
            return

        # Check if reaction is chadyogi or standard reaction
        if payload.emoji.id == 1569432959512223815 or str(payload.emoji) in ("🎉", "🎁"):
            await self.service.add_entry(payload.message_id, payload.user_id)

    @commands.Cog.listener()
    async def on_raw_reaction_remove(self, payload: discord.RawReactionActionEvent) -> None:
        if payload.user_id == self.bot.user.id or payload.guild_id is None:
            return
        gw = await self.service.get_giveaway(payload.message_id)
        if not gw or gw.get("ended"):
            return

        if payload.emoji.id == 1569432959512223815 or str(payload.emoji) in ("🎉", "🎁"):
            await self.service.remove_entry(payload.message_id, payload.user_id)

    # ─────────────────────────────────────────── Slash Commands

    @giveaway_slash.command(name="start", description="Start a giveaway with the custom server template")
    @app_commands.describe(
        duration="Duration of the giveaway (e.g. 30s, 10m, 2h, 1d)",
        prize="What is being given away",
        winners="Number of winners to draw (default: 1)",
        image="Direct URL to an image or GIF banner",
        attachment="Upload an image or GIF file directly",
    )
    @app_commands.checks.has_permissions(manage_guild=True)
    async def slash_start(
        self,
        interaction: discord.Interaction,
        duration: str,
        prize: str,
        winners: app_commands.Range[int, 1, 50] = 1,
        image: Optional[str] = None,
        attachment: Optional[discord.Attachment] = None,
    ) -> None:
        seconds = parse_duration(duration)
        if not seconds or seconds < 5:
            await interaction.response.send_message("❌ Invalid duration! Use formats like `30s`, `10m`, `2h`, or `1d`.", ephemeral=True)
            return

        await interaction.response.defer(ephemeral=True)
        end_timestamp = int(discord.utils.utcnow().timestamp() + seconds)
        guild_name = interaction.guild.name if interaction.guild else "SERVER"

        # Fall back to guild default image if none provided
        default_img = await self.service.get_default_image(interaction.guild_id) if interaction.guild_id else None

        if attachment:
            # Download and re-upload file directly onto the giveaway message
            file_bytes = await attachment.read()
            filename = attachment.filename
            file = discord.File(io.BytesIO(file_bytes), filename=filename)
            embed = build_giveaway_embed(
                guild_name, prize, winners, interaction.user.mention, end_timestamp, image_url=f"attachment://{filename}"
            )
            gw_message = await interaction.channel.send(embed=embed, file=file)
            stored_url = f"attachment://{filename}"
        elif image:
            embed = build_giveaway_embed(
                guild_name, prize, winners, interaction.user.mention, end_timestamp, image_url=image
            )
            gw_message = await interaction.channel.send(embed=embed)
            stored_url = image
        elif default_img:
            embed = build_giveaway_embed(
                guild_name, prize, winners, interaction.user.mention, end_timestamp, image_url=default_img
            )
            gw_message = await interaction.channel.send(embed=embed)
            stored_url = default_img
        else:
            embed = build_giveaway_embed(
                guild_name, prize, winners, interaction.user.mention, end_timestamp
            )
            gw_message = await interaction.channel.send(embed=embed)
            stored_url = None

        # Add chadyogi reaction directly to message
        try:
            await gw_message.add_reaction("<:chadyogi:1569432959512223815>")
        except discord.HTTPException:
            pass

        await self.service.create_giveaway(
            gw_message.id,
            interaction.channel_id,
            interaction.guild_id,
            interaction.user.id,
            prize,
            seconds,
            winners,
            image_url=stored_url,
        )
        await interaction.followup.send(f"✅ Giveaway created! [View Message]({gw_message.jump_url})", ephemeral=True)

    @giveaway_slash.command(name="setimage", description="Set default giveaway image for all future giveaways")
    @app_commands.describe(
        image="Direct URL to an image or GIF banner",
        attachment="Upload an image or GIF file directly",
    )
    @app_commands.checks.has_permissions(manage_guild=True)
    async def slash_setimage(
        self,
        interaction: discord.Interaction,
        image: Optional[str] = None,
        attachment: Optional[discord.Attachment] = None,
    ) -> None:
        if not image and not attachment:
            await interaction.response.send_message("❌ Please provide an image URL or upload an image attachment.", ephemeral=True)
            return

        await interaction.response.defer(ephemeral=True)

        # Resolve image — for URLs we can save directly; for attachments we need a permanent URL
        if attachment:
            resolved_url = attachment.url
        else:
            resolved_url = image

        # Save as guild default for all future giveaways
        await self.service.set_default_image(interaction.guild_id, resolved_url)

        # Also update active giveaway in this channel if one exists
        gw = await self.service.get_latest_active_in_channel(interaction.channel_id)
        if gw:
            channel = self.bot.get_channel(gw["channel_id"])
            if channel:
                try:
                    msg = await channel.fetch_message(gw["message_id"])
                    if msg.embeds:
                        embed = msg.embeds[0]
                        if attachment:
                            file_bytes = await attachment.read()
                            filename = attachment.filename
                            file = discord.File(io.BytesIO(file_bytes), filename=filename)
                            embed.set_image(url=f"attachment://{filename}")
                            await msg.edit(embed=embed, attachments=[file])
                        else:
                            embed.set_image(url=image)
                            await msg.edit(embed=embed)
                        await self.service.update_image(gw["message_id"], resolved_url)
                except discord.HTTPException:
                    pass

            await interaction.followup.send("✅ Default giveaway image saved & updated on active giveaway!", ephemeral=True)
        else:
            await interaction.followup.send("✅ Default giveaway image saved! All future giveaways will use this image.", ephemeral=True)

    @giveaway_slash.command(name="end", description="Immediately end a giveaway and pick winners")
    @app_commands.describe(message_id="The message ID of the giveaway")
    @app_commands.checks.has_permissions(manage_guild=True)
    async def slash_end(self, interaction: discord.Interaction, message_id: str) -> None:
        if not message_id.isdigit():
            await interaction.response.send_message("❌ Please provide a valid numerical message ID.", ephemeral=True)
            return

        await interaction.response.defer(ephemeral=True)
        mid = int(message_id)
        gw = await self.service.get_giveaway(mid)
        if not gw:
            await interaction.followup.send("❌ Giveaway not found.", ephemeral=True)
            return
        if gw["ended"]:
            await interaction.followup.send("❌ That giveaway has already ended.", ephemeral=True)
            return

        await self._finalize_giveaway(mid)
        await interaction.followup.send("✅ Giveaway ended early successfully!", ephemeral=True)

    @giveaway_slash.command(name="reroll", description="Pick new winner(s) for an ended giveaway")
    @app_commands.describe(
        message_id="The message ID of the ended giveaway",
        winners="Number of new winners to draw (default: 1)",
    )
    @app_commands.checks.has_permissions(manage_guild=True)
    async def slash_reroll(
        self,
        interaction: discord.Interaction,
        message_id: str,
        winners: app_commands.Range[int, 1, 20] = 1,
    ) -> None:
        if not message_id.isdigit():
            await interaction.response.send_message("❌ Please provide a valid numerical message ID.", ephemeral=True)
            return

        await interaction.response.defer(ephemeral=True)
        mid = int(message_id)
        res = await self.service.reroll(mid, winners)
        if not res:
            await interaction.followup.send("❌ Giveaway not found.", ephemeral=True)
            return

        gw, new_winners = res
        if not new_winners:
            await interaction.followup.send("❌ No valid entries to pick a new winner from.", ephemeral=True)
            return

        winners_mentions = ", ".join(f"<@{uid}>" for uid in new_winners)
        channel = self.bot.get_channel(gw["channel_id"])
        if channel:
            announcement_text = self.get_winner_announcement(
                channel.guild.id,
                users=winners_mentions,
                prize=gw["prize"],
                host=f"<@{gw['host_id']}>",
            )
            announcement_embed = discord.Embed(
                title="🎉 Giveaway Reroll",
                description=announcement_text,
                colour=discord.Colour.from_rgb(255, 182, 193),
            )
            content_text = f"{EMOJI_PARTY_CAT} CONGRATS {winners_mentions} YOU WON GIVEAWAY BY <@{gw['host_id']}> {EMOJI_FEATHER}"
            await channel.send(content=content_text, embed=announcement_embed)
        await interaction.followup.send(f"✅ Rerolled {len(new_winners)} new winner(s)!", ephemeral=True)

