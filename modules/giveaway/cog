    @commands.command(name="gstart")
    @commands.has_permissions(manage_guild=True)
    async def prefix_gstart(self, ctx: commands.Context, duration: str, *, rest_text: str) -> None:
        seconds = parse_duration(duration)
        if not seconds or seconds < 5:
            await ctx.send("❌ Invalid duration! Use formats like `30s`, `10m`, `2h`, or `1d`.")
            return

        has_attachment = bool(ctx.message.attachments)
        tokens = rest_text.strip().split()
        if not tokens:
            await ctx.send("❌ Please provide a prize! Example: `-gstart 10m Nitro 1`")
            return

        # Check if the last token is an image URL
        resolved_image = None
        if not has_attachment and (tokens[-1].startswith("http://") or tokens[-1].startswith("https://")):
            resolved_image = tokens.pop()

        # Check if the remaining last token or first token is winners (number)
        winners = 1
        if tokens and tokens[-1].isdigit():
            winners = max(1, min(50, int(tokens.pop())))
        elif tokens and tokens[0].isdigit():
            winners = max(1, min(50, int(tokens.pop(0))))

        prize = " ".join(tokens)
        if not prize:
            await ctx.send("❌ Please specify what you are giving away!")
            return

        # Fall back to guild default image if none provided
        if not has_attachment and not resolved_image:
            default_img = await self.service.get_default_image(ctx.guild.id)
            if default_img:
                resolved_image = default_img

        end_timestamp = int(discord.utils.utcnow().timestamp() + seconds)
        guild_name = ctx.guild.name if ctx.guild else "SERVER"

        embed = build_giveaway_embed(
            guild_name, prize, winners, ctx.author.mention, end_timestamp, image_url=resolved_image
        )

        if has_attachment:
            # Re-upload the file directly attached to the giveaway message
            att = ctx.message.attachments[0]
            file_bytes = await att.read()
            filename = att.filename
            file = discord.File(io.BytesIO(file_bytes), filename=filename)
            embed.set_image(url=f"attachment://{filename}")
            gw_message = await ctx.send(embed=embed, file=file)
            stored_url = f"attachment://{filename}"
        else:
            gw_message = await ctx.send(embed=embed)
            stored_url = resolved_image

        # Add chadyogi reaction
        try:
            await gw_message.add_reaction("<:chadyogi:1569432959512223815>")
        except discord.HTTPException:
            pass

        await self.service.create_giveaway(
            gw_message.id,
            ctx.channel.id,
            ctx.guild.id,
            ctx.author.id,
            prize,
            seconds,
            winners,
            image_url=stored_url,
        )

