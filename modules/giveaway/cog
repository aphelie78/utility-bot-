        gw = await self.service.get_latest_active_in_channel(ctx.channel.id)
        if gw:
            channel = self.bot.get_channel(gw["channel_id"])
            if channel:
                try:
                    msg = await channel.fetch_message(gw["message_id"])
                    if msg.embeds:
                        embed = msg.embeds[0]
                        if has_attachment:
                            att = ctx.message.attachments[0]
                            file_bytes = await att.read()
                            filename = att.filename
                            file = discord.File(io.BytesIO(file_bytes), filename=filename)
                            embed.set_image(url=f"attachment://{filename}")
                            await msg.edit(embed=embed, attachments=[file])
                        else:
                            embed.set_image(url=image_url)
                            await msg.edit(embed=embed)
                        await self.service.update_image(gw["message_id"], resolved_url)
                except discord.HTTPException:
                    pass

            await ctx.send("✅ Default giveaway image saved & updated on active giveaway!")
        else:
            await ctx.send("✅ Default giveaway image saved! All future giveaways will use this image.")

    @commands.command(name="gend")
    @commands.has_permissions(manage_guild=True)
    async def prefix_gend(self, ctx: commands.Context, message_id: int) -> None:
        gw = await self.service.get_giveaway(message_id)
        if not gw:
            await ctx.send("❌ Giveaway not found.")
            return
        if gw["ended"]:
            await ctx.send("❌ That giveaway has already ended.")
            return

        await self._finalize_giveaway(message_id)
        await ctx.send("✅ Giveaway ended early successfully!")

    @commands.command(name="greroll")
    @commands.has_permissions(manage_guild=True)
    async def prefix_greroll(self, ctx: commands.Context, message_id: int, winners: int = 1) -> None:
        res = await self.service.reroll(message_id, winners)
        if not res:
            await ctx.send("❌ Giveaway not found.")
            return

        gw, new_winners = res
        if not new_winners:
            await ctx.send("❌ No valid entries to pick a new winner from.")
            return

        winners_mentions = ", ".join(f"<@{uid}>" for uid in new_winners)
        channel = self.bot.get_channel(gw["channel_id"])
        if channel:
            announcement_text = self.get_winner_announcement(
                channel.guild.id,
                users=winners_mentions,
                prize=gw["prize"],
                host=f"<@{gw['host_id']}>",
            )
            announcement_embed = discord.Embed(
                title="🎉 Giveaway Reroll",
                description=announcement_text,
                colour=discord.Colour.from_rgb(255, 182, 193),
            )
            content_text = f"{EMOJI_PARTY_CAT} CONGRATS {winners_mentions} YOU WON GIVEAWAY BY <@{gw['host_id']}> {EMOJI_FEATHER}"
            await channel.send(content=content_text, embed=announcement_embed)


